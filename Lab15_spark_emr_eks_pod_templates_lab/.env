AIRFLOW_UID=5000
AWS_DEFAULT_REGION=us-west-2
# EMR on EKS Target Cluster Settings
VIRTUAL_CLUSTER_ID=abc123def456ghi789
EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/EMRJobExecutionRole
ECR_REPO_URL=123456789012.dkr.ecr.us-west-2.amazonaws.com/spark-emr-eks
S3_BUCKET=my-emr-eks-pod-templates-bucket
